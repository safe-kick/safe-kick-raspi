# Runtime feature flags
ENABLE_FACE_API=true
ENABLE_TEST_API=false
ALLOW_MANUAL_UNLOCK=false

# Live face and bicycle helmet verification
FACE_MATCH_THRESHOLD=0.40
ROBOFLOW_API_KEY=
ROBOFLOW_HELMET_MODEL_ID=bike-helmet-detection-2vdjo-mqa2s/1
HELMET_CONFIDENCE_THRESHOLD=0.50

# STM32 UART
USE_UART_MOCK=true
SERIAL_PORT=/dev/serial0
BAUD_RATE=115200

# App/backend integration
INTERNAL_API_KEY=
NODE_SUMMARY_URL=
NODE_SUMMARY_TOKEN=
NODE_SUMMARY_TIMEOUT_SECONDS=3
