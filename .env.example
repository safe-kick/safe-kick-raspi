# Runtime feature flags
ENABLE_FACE_API=true
ENABLE_TEST_API=false
ALLOW_MANUAL_UNLOCK=false

# Live face and bicycle helmet verification
FACE_MATCH_THRESHOLD=0.30
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_HELMET_WORKSPACE=8-_-_1-_
ROBOFLOW_HELMET_WORKFLOW_ID=helmet-vhelmet-srsz5-kcvrn-2-yolo11n-t1-logic
HELMET_DEBUG_RESPONSE=false
HELMET_WITH_CONFIDENCE=0.90
HELMET_WITHOUT_MAX_CONFIDENCE=0.50
HELMET_INFERENCE_TIMEOUT_SECONDS=30

# STM32 UART
USE_UART_MOCK=false
SERIAL_PORT=/dev/serial0
BAUD_RATE=115200

# HW-484 active-low breath sensor
USE_GPIO_MOCK=false
MIC_GPIO=17
MIN_BLOW_SECONDS=0.5
MAX_GAP_SECONDS=0.5

# App/backend integration
INTERNAL_API_KEY=
NODE_SUMMARY_URL=
NODE_SUMMARY_TOKEN=
NODE_SUMMARY_TIMEOUT_SECONDS=3

# Node/PostgreSQL 얼굴 임베딩 저장소. 비워두면 개발용 로컬 파일 저장소를 사용합니다.
NODE_FACE_EMBEDDING_URL=http://node-server:3000/internal/face-embeddings
NODE_EMBEDDING_TIMEOUT_SECONDS=3
KICKBOARD_DEVICE_ID=RPI-001
INTERNAL_API_KEY=replace-with-the-same-long-random-value-as-node
